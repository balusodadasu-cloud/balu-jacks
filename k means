import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double[] a = {2, 4, 5, 10, 12, 15};
        double[] c = {2, 10};
        int[] cl = new int[a.length];

        for (int t = 0; t < 10; t++) {
            double[] sum = new double[2];
            int[] count = new int[2];

            for (int i = 0; i < a.length; i++) {
                cl[i] = Math.abs(a[i] - c[0]) <
                        Math.abs(a[i] - c[1]) ? 0 : 1;
                sum[cl[i]] += a[i];
                count[cl[i]]++;
            }

            for (int j = 0; j < 2; j++)
                if (count[j] > 0)
                    c[j] = sum[j] / count[j];
        }

        for (int j = 0; j < 2; j++) {
            System.out.print("Cluster " + (j + 1) + ": ");
            for (int i = 0; i < a.length; i++)
                if (cl[i] == j) System.out.print(a[i] + " ");
            System.out.println();
        }
    }
}
